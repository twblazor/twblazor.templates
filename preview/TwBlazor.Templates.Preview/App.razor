@inject TwBlazorOptions TwOptions

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["_content/twblazor/icons/bootstrap-icons.min.css"]" />
    <link rel="stylesheet" href="@Assets["css/output.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body class="min-h-dvh antialiased @TwOptions.Theme.Colors.NeutralSurface.Body @TwOptions.Theme.Colors.NeutralText.Heading">
    <Routes @rendermode="InteractiveServer" />
    <div title="Preview layout" style="position: fixed; right: 1rem; bottom: 1rem; z-index: 1000; display: flex; gap: .25rem; padding: .25rem; border-radius: .5rem; background: #fff; border: 1px solid #e5e7eb; box-shadow: 0 4px 12px rgb(0 0 0 / 15%); font: 600 12px/1.2 system-ui, sans-serif;">
        <a href="/" style="padding: .35rem .6rem; border-radius: .35rem; color: #4b5563; text-decoration: none;">Dashboard</a>
        <a href="/sidebar" style="padding: .35rem .6rem; border-radius: .35rem; color: #4b5563; text-decoration: none;">Sidebar</a>
        <a href="/navbar" style="padding: .35rem .6rem; border-radius: .35rem; color: #4b5563; text-decoration: none;">Navbar</a>
        <a href="/blank" style="padding: .35rem .6rem; border-radius: .35rem; color: #4b5563; text-decoration: none;">Blank</a>
    </div>
    <script src="@Assets["_content/twblazor/js/twblazor.js"]"></script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
