@page "/"

<PageTitle>Welcome</PageTitle>

<div class="mx-auto w-full max-w-6xl space-y-8">
    <section class="relative overflow-hidden rounded-3xl border border-purple-100 bg-linear-to-br from-purple-50 via-white to-fuchsia-50 p-6 sm:p-10 dark:border-white/10 dark:from-purple-500/10 dark:via-transparent dark:to-fuchsia-500/10">
        <div class="pointer-events-none absolute -end-24 -top-24 size-72 rounded-full bg-fuchsia-200/40 blur-3xl dark:bg-fuchsia-500/10" aria-hidden="true"></div>
        <div class="relative grid items-center gap-8 lg:grid-cols-[1.2fr_1fr]">
            <div>
                <span class="inline-flex items-center gap-1.5 rounded-full border border-purple-200 bg-white/80 px-3 py-1 text-xs font-semibold text-purple-700 dark:border-purple-400/20 dark:bg-white/5 dark:text-purple-200">
                    <TwIcon Icon="Icon.Lightning_Charge_Fill" Class="text-[0.7rem]" />
                    twblazor starter
                </span>
                <h1 class="mt-4 text-3xl font-bold tracking-tight sm:text-4xl lg:text-5xl">Build something people enjoy using.</h1>
                <p class="mt-4 max-w-xl text-sm leading-6 text-gray-600 sm:text-base dark:text-gray-300">
                    This is your starting point: a clean layout, a theme you own, and accessible components that look good out of the box. Change the colours, add your pages, and make it yours.
                </p>
                <div class="mt-6 flex flex-wrap gap-2">
                    <TwButton Label="Open settings"
                              Variant="ButtonVariant.Filled"
                              Color="Color.Primary"
                              StartIcon="Icon.Gear"
                              Href="/settings" />
                    <TwButton Label="Browse components"
                              Variant="ButtonVariant.Outlined"
                              Color="Color.Dark"
                              EndIcon="Icon.Arrow_Up_Right"
                              Href="https://twblazor.com"
                              Target="_blank" />
                </div>
            </div>

            <TwCard Title="Try the components" TitleLevel="2" Bordered="false" Class="bg-white/80 backdrop-blur dark:bg-white/5">
                <p class="text-sm text-gray-600 dark:text-gray-300">Both of these are live. The layout is interactive, so the state stays with the page.</p>
                <div class="mt-4 space-y-4">
                    <div>
                        <TwButton Label="@($"Clicked {clickCount} times")"
                                  Variant="ButtonVariant.Filled"
                                  Color="Color.Accent"
                                  StartIcon="Icon.Cursor_Fill"
                                  OnClick="Increment" />
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400" role="status">@(clickCount == 0 ? "Give it a click." : "It works. Replace this with your own action.")</p>
                    </div>
                    <div class="border-t border-gray-200 pt-4 dark:border-white/10">
                        <TwSwitch @bind-Value="notificationsEnabled" Label="Email notifications" Color="Color.Primary" />
                        <p class="mt-1.5 text-xs text-gray-500 dark:text-gray-400">Notifications are @(notificationsEnabled ? "on" : "off").</p>
                    </div>
                </div>
            </TwCard>
        </div>
    </section>

    <div class="grid gap-4 md:grid-cols-3">
        <TwCard Title="Pages" TitleLevel="2">
            <span class="grid size-10 place-items-center rounded-xl bg-purple-50 text-purple-700 dark:bg-purple-500/10 dark:text-purple-300">
                <TwIcon Icon="Icon.File_Text" Class="text-lg" />
            </span>
            <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
                Add a <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">.razor</code> file with an <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">@("@page")</code> route to <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">Pages</code>.
            </p>
        </TwCard>
        <TwCard Title="Navigation" TitleLevel="2">
            <span class="grid size-10 place-items-center rounded-xl bg-purple-50 text-purple-700 dark:bg-purple-500/10 dark:text-purple-300">
                <TwIcon Icon="Icon.Signpost_Split_Fill" Class="text-lg" />
            </span>
            <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
                Add the route to <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">AppNavigation.cs</code> and it appears in the sidebar or top bar.
            </p>
        </TwCard>
        <TwCard Title="Theme" TitleLevel="2">
            <span class="grid size-10 place-items-center rounded-xl bg-purple-50 text-purple-700 dark:bg-purple-500/10 dark:text-purple-300">
                <TwIcon Icon="Icon.Palette_Fill" Class="text-lg" />
            </span>
            <p class="mt-3 text-sm leading-6 text-gray-600 dark:text-gray-300">
                Every component is styled from <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">Theme.cs</code>. Generate a new one at twblazor.com/theme.
            </p>
        </TwCard>
    </div>

    <TwCard Title="What is included" TitleLevel="2">
        <div class="grid gap-3 sm:grid-cols-2">
            <div class="flex items-start gap-2.5">
                <TwIcon Icon="Icon.Check_Circle_Fill" Class="mt-0.5 text-green-600 dark:text-green-400" />
                <p class="text-sm leading-6 text-gray-600 dark:text-gray-300">A dashboard, sidebar or navbar layout, ready to use.</p>
            </div>
            <div class="flex items-start gap-2.5">
                <TwIcon Icon="Icon.Check_Circle_Fill" Class="mt-0.5 text-green-600 dark:text-green-400" />
                <p class="text-sm leading-6 text-gray-600 dark:text-gray-300">Toast and dialog providers wired into the layout.</p>
            </div>
            <div class="flex items-start gap-2.5">
                <TwIcon Icon="Icon.Check_Circle_Fill" Class="mt-0.5 text-green-600 dark:text-green-400" />
                <p class="text-sm leading-6 text-gray-600 dark:text-gray-300">Tailwind CSS with no pre-built stylesheet to fight.</p>
            </div>
            <div class="flex items-start gap-2.5">
                <TwIcon Icon="Icon.Check_Circle_Fill" Class="mt-0.5 text-green-600 dark:text-green-400" />
                <p class="text-sm leading-6 text-gray-600 dark:text-gray-300">Light and dark mode classes on every page.</p>
            </div>
        </div>
    </TwCard>
</div>

@code {
    private int clickCount;
    private bool notificationsEnabled = true;

    private void Increment() => clickCount++;
}
