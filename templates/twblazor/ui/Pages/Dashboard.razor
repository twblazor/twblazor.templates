@page "/"
@using TwBlazor.Models
@inject ITwToastService ToastService
@inject TwBlazorOptions Options

<PageTitle>Dashboard</PageTitle>

<TwContainer MaxWidth="ContainerSize.Xl7" Gutter="0" Class="space-y-6">
    <TwFlex Direction="FlexDirection.Col" DirectionSm="FlexDirection.Row" Justify="JustifyContent.Between" Align="AlignItems.Start" Gap="4">
        <TwFlexItem MinWidthZero>
            <TwText Element="LayoutElement.P"
                    Color="Color.Primary"
                    Size="TextSize.Xs"
                    Weight="TextWeight.Semibold"
                    Class="uppercase tracking-widest">Dashboard</TwText>
            <TwText Element="LayoutElement.H1"
                    Size="TextSize.Xl2"
                    Weight="TextWeight.Bold"
                    Class="mt-1 tracking-tight sm:text-3xl">Store overview</TwText>
            <TwText Element="LayoutElement.P"
                    Size="TextSize.Sm"
                    Tone="TextTone.Muted"
                    Class="mt-1">Here is how the store is performing this week.</TwText>
        </TwFlexItem>
        <TwFlex Wrap="FlexWrap.Wrap" Gap="2">
            <TwButton Label="Export"
                      Variant="ButtonVariant.Outlined"
                      Color="Color.Dark"
                      StartIcon="Icon.Download"
                      Dense
                      OnClick="ShowExportToast" />
            <TwButton Label="New order"
                      Variant="ButtonVariant.Filled"
                      Color="Color.Primary"
                      StartIcon="Icon.Plus_Lg"
                      Dense
                      OnClick="ShowNewOrderToast" />
        </TwFlex>
    </TwFlex>

    <TwContainer Element="LayoutElement.Section"
                 AriaLabelledBy="goal-heading"
                 MaxWidth="ContainerSize.Full"
                 Gutter="6"
                 PaddingY="6"
                 Class="@($"relative overflow-hidden rounded-2xl {brandSurface} text-white shadow-xl shadow-black/20")">
        <div class="pointer-events-none absolute -end-16 -top-20 size-64 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-24 start-1/3 size-56 rounded-full bg-white/10 blur-3xl" aria-hidden="true"></div>

        <TwFlex Direction="FlexDirection.Col" DirectionLg="FlexDirection.Row" Justify="JustifyContent.Between" Align="AlignItems.Center" Gap="6" Class="relative">
            <TwFlexItem MinWidthZero>
                <TwText Element="LayoutElement.P"
                        Size="TextSize.Xs"
                        Weight="TextWeight.Semibold"
                        Tone="TextTone.Inherit"
                        Class="uppercase tracking-widest text-white/70">This month</TwText>
                <TwText Element="LayoutElement.H2"
                        Id="goal-heading"
                        Size="TextSize.Xl3"
                        Weight="TextWeight.Bold"
                        Tone="TextTone.Inherit"
                        Class="mt-2 tracking-tight sm:text-4xl">£42,180 of £50,000</TwText>
                <TwText Element="LayoutElement.P"
                        Size="TextSize.Sm"
                        Tone="TextTone.Inherit"
                        Class="mt-2 leading-6 text-white/80">
                    You are 84% of the way to the monthly revenue goal, with 6 days left. That is £3,940 more than this time last month.
                </TwText>
            </TwFlexItem>

            <TwGrid Cols="1" ColsSm="2" Gap="4" Class="shrink-0">
                <TwFlex Direction="FlexDirection.Col" Gap="0">
                    <TwText Element="LayoutElement.P" Size="TextSize.Xl2" Weight="TextWeight.Bold" Tone="TextTone.Inherit">+12.4%</TwText>
                    <TwText Element="LayoutElement.P" Size="TextSize.Xs" Tone="TextTone.Inherit" Class="text-white/70">vs. last month</TwText>
                </TwFlex>
                <TwFlex Direction="FlexDirection.Col" Gap="0" Class="sm:border-s sm:border-white/20 sm:ps-4">
                    <TwText Element="LayoutElement.P" Size="TextSize.Xl2" Weight="TextWeight.Bold" Tone="TextTone.Inherit">6 days</TwText>
                    <TwText Element="LayoutElement.P" Size="TextSize.Xs" Tone="TextTone.Inherit" Class="text-white/70">left to hit the goal</TwText>
                </TwFlex>
            </TwGrid>
        </TwFlex>

        <TwFlex Justify="JustifyContent.Between" Align="AlignItems.Center" Class="relative mt-6 text-xs text-white/80">
            <span>Monthly target</span>
            <span>84%</span>
        </TwFlex>
        <TwProgress T="int"
                    Value="84"
                    Max="100"
                    Size="ProgressSize.Small"
                    Color="Color.Light"
                    AriaLabel="Monthly revenue target"
                    Class="relative mt-2 border-white/20 bg-white/20 [&::-webkit-progress-bar]:bg-transparent [&::-webkit-progress-value]:bg-white [&::-moz-progress-bar]:bg-white" />
    </TwContainer>

    <TwGrid Cols="1" ColsSm="2" ColsXl="4" Gap="4">
        @foreach (var stat in stats)
        {
            <TwCard Title="@stat.Label" TitleLevel="2">
                <TwFlex Justify="JustifyContent.Between" Align="AlignItems.Start" Gap="3">
                    <TwFlexItem MinWidthZero>
                        <TwText Element="LayoutElement.P" Size="TextSize.Xl2" Weight="TextWeight.Bold" Class="tracking-tight">@stat.Value</TwText>
                        <TwText Element="LayoutElement.P" Color="Color.Success" Size="TextSize.Xs" Weight="TextWeight.Medium" Class="mt-1">@stat.Change</TwText>
                    </TwFlexItem>
                    <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-10 shrink-0 rounded-xl {primaryTile}")">
                        <TwIcon Icon="@stat.Icon" Color="Color.Primary" Class="text-lg" />
                    </TwFlex>
                </TwFlex>
            </TwCard>
        }
    </TwGrid>

    <TwGrid Cols="1" ColsSm="2" ColsXl="4" Gap="6">
        <TwGridItem ColSpanSm="2" ColSpanXl="2">
            <TwChart Title="Revenue" Description="Last 6 months · GBP" Class="@chartSurface">
                <TwAreaChart Categories="@revenueMonths"
                             Series="@revenueSeries"
                             Curve="ChartCurve.Smooth"
                             ValueFormat="C0" />
            </TwChart>
        </TwGridItem>

        <TwChart Title="Traffic by source" Description="Visits this month" Class="@chartSurface">
            <TwPieChart Data="@trafficSources"
                        InnerRadius="0.6"
                        CenterText="4,120"
                        ValueFormat="N0" />
        </TwChart>

        <TwChart Title="Orders this week" Description="Last 5 days" Class="@chartSurface">
            <TwColumnChart Categories="@orderDays"
                           Series="@orderSeries"
                           ValueFormat="N0" />
        </TwChart>
    </TwGrid>

    <TwGrid Cols="1" ColsLg="3" Gap="6">
        <TwGridItem ColSpanLg="2" AlignSelf="AlignSelf.Start">
            <TwCard Title="Recent orders" TitleLevel="2">
                <HeaderContent>
                    <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Muted">The latest 5 orders across the store.</TwText>
                </HeaderContent>
                <ChildContent>
                    <TwTable Hoverable NoBorder Class="text-sm">
                        <TableHeader>
                            <tr>
                                <th scope="col" class="px-4 py-3">Order</th>
                                <th scope="col" class="px-4 py-3">Customer</th>
                                <th scope="col" class="px-4 py-3">Status</th>
                                <th scope="col" class="px-4 py-3 text-end">Total</th>
                            </tr>
                        </TableHeader>
                        <TableBody>
                            @foreach (var order in orders)
                            {
                                <tr>
                                    <th scope="row" class="px-4 py-3 font-medium whitespace-nowrap">@order.Number</th>
                                    <td class="px-4 py-3">@order.Customer</td>
                                    <td class="px-4 py-3">
                                        <TwChip Label="@order.Status" Color="@order.StatusColor" Variant="ButtonVariant.Filled" Size="ChipSize.Small" />
                                    </td>
                                    <td class="px-4 py-3 text-end font-medium whitespace-nowrap">@order.Total</td>
                                </tr>
                            }
                        </TableBody>
                    </TwTable>
                </ChildContent>
            </TwCard>
        </TwGridItem>

        <TwFlex Direction="FlexDirection.Col" Gap="6">
            <TwCard Title="Top products" TitleLevel="2">
                <TwFlex Direction="FlexDirection.Col" Gap="4">
                    @foreach (var product in products)
                    {
                        <TwFlex Direction="FlexDirection.Col" Gap="2">
                            <TwFlex Justify="JustifyContent.Between" Align="AlignItems.Baseline" Gap="3">
                                <TwFlexItem MinWidthZero>
                                    <TwText Element="LayoutElement.P" Size="TextSize.Sm" Weight="TextWeight.Medium" Truncate>@product.Name</TwText>
                                </TwFlexItem>
                                <TwFlexItem Shrink="false">
                                    <TwText Element="LayoutElement.P" Size="TextSize.Xs" Tone="TextTone.Subtle">@product.Revenue</TwText>
                                </TwFlexItem>
                            </TwFlex>
                            <TwProgress T="int"
                                        Value="@product.Share"
                                        Max="100"
                                        Size="ProgressSize.Small"
                                        Color="Color.Primary"
                                        AriaLabel="@($"{product.Name} share of sales")" />
                        </TwFlex>
                    }
                </TwFlex>
            </TwCard>

            <TwCard Title="Latest activity" TitleLevel="2">
                <TwFlex Direction="FlexDirection.Col" Gap="4">
                    @foreach (var item in activity)
                    {
                        <TwFlex Gap="3">
                            <TwAvatar Initials="@item.Initials" Color="@item.Color" Size="AvatarSize.Small" />
                            <TwFlexItem MinWidthZero>
                                <TwText Element="LayoutElement.P" Size="TextSize.Sm" Class="leading-5">
                                    <TwText Weight="TextWeight.Medium">@item.Who</TwText>
                                    <TwText Tone="TextTone.Muted">@item.What</TwText>
                                </TwText>
                                <TwText Element="LayoutElement.P" Size="TextSize.Xs" Tone="TextTone.Subtle" Class="mt-0.5">@item.When</TwText>
                            </TwFlexItem>
                        </TwFlex>
                    }
                </TwFlex>
            </TwCard>
        </TwFlex>
    </TwGrid>
</TwContainer>

@code {
    private sealed record Stat(string Label, string Value, string Change, Icon Icon);

    private sealed record Order(string Number, string Customer, string Status, Color StatusColor, string Total);

    private sealed record Product(string Name, string Revenue, int Share);

    private sealed record Activity(string Who, string Initials, Color Color, string What, string When);

    private string brandSurface =>
        $"{Options.Theme.Colors.LightBackground.Medium.Primary} {Options.Theme.Colors.DarkBackground.Medium.Primary}";

    private string primaryTile =>
        $"{Options.Theme.Colors.LightBackground.Lightest.Primary} {Options.Theme.Colors.DarkBackground.Darkest.Primary}";

    private string chartSurface =>
        $"h-full rounded-xl border p-5 {Options.Theme.Colors.NeutralSurface.Border} {Options.Theme.Colors.NeutralSurface.Background}";

    private static readonly Stat[] stats =
    [
        new("Revenue", "£42,180", "+12.4% this month", Icon.Currency_Pound),
        new("Orders", "1,284", "+8.2% this month", Icon.Cart_Fill),
        new("Customers", "892", "+3.1% this month", Icon.People),
        new("Refund rate", "1.2%", "-0.3% this month", Icon.Shield_Check)
    ];

    private static readonly string[] revenueMonths = ["May", "Jun", "Jul", "Aug", "Sep", "Oct"];

    private static readonly ChartSeries[] revenueSeries =
    [
        new("Revenue", [28400, 31200, 33800, 35600, 39400, 42180])
    ];

    private static readonly ChartValue[] trafficSources =
    [
        new("Search", 1840),
        new("Direct", 1120),
        new("Social", 760),
        new("Email", 400)
    ];

    private static readonly string[] orderDays = ["Mon", "Tue", "Wed", "Thu", "Fri"];

    private static readonly ChartSeries[] orderSeries =
    [
        new("Orders", [84, 92, 78, 105, 96])
    ];

    private static readonly Order[] orders =
    [
        new("#1048", "Ava Thompson", "Paid", Color.Success, "£148.00"),
        new("#1047", "Noah Williams", "Processing", Color.Info, "£86.50"),
        new("#1046", "Mia Patel", "Paid", Color.Success, "£212.00"),
        new("#1045", "Liam Carter", "Pending", Color.Warning, "£54.25"),
        new("#1044", "Sofia Rossi", "Refunded", Color.Danger, "£96.00")
    ];

    private static readonly Product[] products =
    [
        new("Everyday tote", "£12,480", 72),
        new("Weekender bag", "£8,940", 54),
        new("Leather wallet", "£5,210", 31),
        new("Travel pouch", "£2,860", 18)
    ];

    private static readonly Activity[] activity =
    [
        new("Ava Thompson", "AT", Color.Success, " placed order #1048.", "12 minutes ago"),
        new("Noah Williams", "NW", Color.Info, " started a return.", "48 minutes ago"),
        new("Mia Patel", "MP", Color.Accent, " left a 5 star review.", "2 hours ago"),
        new("Sofia Rossi", "SR", Color.Warning, " updated their address.", "Yesterday")
    ];

    private void ShowExportToast() =>
        ToastService.ShowInfo("Export ready", "Connect this button to your reporting pipeline.");

    private void ShowNewOrderToast() =>
        ToastService.ShowSuccess("New order", "The order form is ready to be wired up.");
}
