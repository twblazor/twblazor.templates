@page "/"
@inject ITwToastService ToastService

<PageTitle>Dashboard</PageTitle>

<div class="mx-auto w-full max-w-7xl space-y-6">
    <div class="flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
        <div>
            <p class="text-xs font-semibold uppercase tracking-widest text-purple-700 dark:text-purple-300">Dashboard</p>
            <h1 class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl">Good morning, Jane</h1>
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">Here is how the store is performing this week.</p>
        </div>
        <div class="flex flex-wrap gap-2">
            <TwButton Label="Export"
                      Variant="ButtonVariant.Outlined"
                      Color="Color.Dark"
                      StartIcon="Icon.Download"
                      Dense
                      OnClick="ShowExportToast" />
            <TwButton Label="New order"
                      Variant="ButtonVariant.Filled"
                      Color="Color.Primary"
                      StartIcon="Icon.Plus_Lg"
                      Dense
                      OnClick="ShowNewOrderToast" />
        </div>
    </div>

    <section class="relative overflow-hidden rounded-2xl bg-linear-to-br from-purple-700 via-purple-600 to-fuchsia-600 p-6 text-white shadow-lg sm:p-8" aria-labelledby="goal-heading">
        <div class="pointer-events-none absolute -end-16 -top-20 size-64 rounded-full bg-white/10 blur-2xl" aria-hidden="true"></div>
        <div class="pointer-events-none absolute -bottom-24 start-1/3 size-56 rounded-full bg-fuchsia-300/20 blur-3xl" aria-hidden="true"></div>
        <div class="relative flex flex-col gap-6 lg:flex-row lg:items-center lg:justify-between">
            <div class="max-w-xl">
                <p class="text-xs font-semibold uppercase tracking-widest text-white/70">This month</p>
                <h2 id="goal-heading" class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">£42,180 of £50,000</h2>
                <p class="mt-2 text-sm leading-6 text-white/80">
                    You are 84% of the way to the monthly revenue goal, with 6 days left. That is £3,940 more than this time last month.
                </p>
            </div>
            <div class="flex shrink-0 items-center gap-6">
                <div>
                    <p class="text-2xl font-bold">+12.4%</p>
                    <p class="text-xs text-white/70">vs. last month</p>
                </div>
                <div class="hidden h-12 w-px bg-white/20 sm:block" aria-hidden="true"></div>
                <div class="hidden sm:block">
                    <p class="text-2xl font-bold">6 days</p>
                    <p class="text-xs text-white/70">left to hit the goal</p>
                </div>
            </div>
        </div>
        <div class="relative mt-6">
            <div class="flex items-center justify-between text-xs text-white/80">
                <span>Monthly target</span>
                <span>84%</span>
            </div>
            <div class="mt-2 h-2 overflow-hidden rounded-full bg-white/20" role="progressbar" aria-label="Monthly revenue target" aria-valuenow="84" aria-valuemin="0" aria-valuemax="100">
                <div class="h-full w-[84%] rounded-full bg-white"></div>
            </div>
        </div>
    </section>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
        @foreach (var stat in stats)
        {
            <TwCard Title="@stat.Label" TitleLevel="2">
                <div class="flex items-start justify-between gap-3">
                    <div>
                        <p class="text-2xl font-bold tracking-tight">@stat.Value</p>
                        <p class="mt-1 text-xs font-medium text-green-700 dark:text-green-400">@stat.Change</p>
                    </div>
                    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-purple-50 text-purple-700 dark:bg-purple-500/10 dark:text-purple-300">
                        <TwIcon Icon="@stat.Icon" Class="text-lg" />
                    </span>
                </div>
            </TwCard>
        }
    </div>

    <div class="grid gap-6 lg:grid-cols-3">
        <TwCard Title="Recent orders" TitleLevel="2" Class="lg:col-span-2">
            <HeaderContent>
                <p class="text-sm text-gray-600 dark:text-gray-400">The latest 5 orders across the store.</p>
            </HeaderContent>
            <ChildContent>
                <TwTable Hoverable NoBorder Class="text-sm">
                    <TableHeader>
                        <tr>
                            <th scope="col" class="px-4 py-3">Order</th>
                            <th scope="col" class="px-4 py-3">Customer</th>
                            <th scope="col" class="px-4 py-3">Status</th>
                            <th scope="col" class="px-4 py-3 text-end">Total</th>
                        </tr>
                    </TableHeader>
                    <TableBody>
                        @foreach (var order in orders)
                        {
                            <tr>
                                <th scope="row" class="px-4 py-3 font-medium whitespace-nowrap">@order.Number</th>
                                <td class="px-4 py-3">@order.Customer</td>
                                <td class="px-4 py-3">
                                    <TwChip Label="@order.Status" Color="@order.StatusColor" Variant="ButtonVariant.Filled" Size="ChipSize.Small" />
                                </td>
                                <td class="px-4 py-3 text-end font-medium whitespace-nowrap">@order.Total</td>
                            </tr>
                        }
                    </TableBody>
                </TwTable>
            </ChildContent>
        </TwCard>

        <div class="space-y-6">
            <TwCard Title="Top products" TitleLevel="2">
                <div class="space-y-4">
                    @foreach (var product in products)
                    {
                        <div>
                            <div class="flex items-baseline justify-between gap-3">
                                <p class="truncate text-sm font-medium">@product.Name</p>
                                <p class="shrink-0 text-xs text-gray-500 dark:text-gray-400">@product.Revenue</p>
                            </div>
                            <div class="mt-2 h-1.5 overflow-hidden rounded-full bg-gray-100 dark:bg-white/10" role="progressbar" aria-label="@($"{product.Name} share of sales")" aria-valuenow="@product.Share" aria-valuemin="0" aria-valuemax="100">
                                <div class="h-full rounded-full bg-linear-to-r from-purple-600 to-fuchsia-500" style="@($"width: {product.Share}%")"></div>
                            </div>
                        </div>
                    }
                </div>
            </TwCard>

            <TwCard Title="Latest activity" TitleLevel="2">
                <div class="space-y-4">
                    @foreach (var item in activity)
                    {
                        <div class="flex gap-3">
                            <TwAvatar Initials="@item.Initials" Color="@item.Color" Size="AvatarSize.Small" />
                            <div class="min-w-0">
                                <p class="text-sm leading-5">
                                    <span class="font-medium">@item.Who</span>
                                    <span class="text-gray-600 dark:text-gray-400">@item.What</span>
                                </p>
                                <p class="mt-0.5 text-xs text-gray-500 dark:text-gray-400">@item.When</p>
                            </div>
                        </div>
                    }
                </div>
            </TwCard>
        </div>
    </div>
</div>

@code {
    private sealed record Stat(string Label, string Value, string Change, Icon Icon);

    private sealed record Order(string Number, string Customer, string Status, Color StatusColor, string Total);

    private sealed record Product(string Name, string Revenue, int Share);

    private sealed record Activity(string Who, string Initials, Color Color, string What, string When);

    private static readonly Stat[] stats =
    [
        new("Revenue", "£42,180", "+12.4% this month", Icon.Currency_Pound),
        new("Orders", "1,284", "+8.2% this month", Icon.Cart_Fill),
        new("Customers", "892", "+3.1% this month", Icon.People),
        new("Refund rate", "1.2%", "-0.3% this month", Icon.Shield_Check)
    ];

    private static readonly Order[] orders =
    [
        new("#1048", "Ava Thompson", "Paid", Color.Success, "£148.00"),
        new("#1047", "Noah Williams", "Processing", Color.Info, "£86.50"),
        new("#1046", "Mia Patel", "Paid", Color.Success, "£212.00"),
        new("#1045", "Liam Carter", "Pending", Color.Warning, "£54.25"),
        new("#1044", "Sofia Rossi", "Refunded", Color.Danger, "£96.00")
    ];

    private static readonly Product[] products =
    [
        new("Everyday tote", "£12,480", 72),
        new("Weekender bag", "£8,940", 54),
        new("Leather wallet", "£5,210", 31),
        new("Travel pouch", "£2,860", 18)
    ];

    private static readonly Activity[] activity =
    [
        new("Ava Thompson", "AT", Color.Success, " placed order #1048.", "12 minutes ago"),
        new("Noah Williams", "NW", Color.Info, " started a return.", "48 minutes ago"),
        new("Mia Patel", "MP", Color.Accent, " left a 5 star review.", "2 hours ago"),
        new("Sofia Rossi", "SR", Color.Warning, " updated their address.", "Yesterday")
    ];

    private void ShowExportToast() =>
        ToastService.ShowInfo("Export ready", "Connect this button to your reporting pipeline.");

    private void ShowNewOrderToast() =>
        ToastService.ShowSuccess("New order", "The order form is ready to be wired up.");
}
