@page "/not-found"
@layout MainLayout

<PageTitle>Page not found</PageTitle>

<TwFlex Direction="FlexDirection.Col" Align="AlignItems.Center" Justify="JustifyContent.Center" FullHeight Gap="0" Class="min-h-[60vh] px-4 text-center">
    <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="size-16 rounded-2xl bg-purple-50 text-purple-700 dark:bg-purple-500/10 dark:text-purple-300">
        <TwIcon Icon="Icon.Compass" Class="text-3xl" />
    </TwFlex>
    <p class="mt-6 text-xs font-semibold uppercase tracking-widest text-purple-700 dark:text-purple-300">404</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight sm:text-4xl">This page took a wrong turn.</h1>
    <p class="mt-3 max-w-md text-sm leading-6 text-gray-600 dark:text-gray-400">
        The page you are looking for does not exist, or it may have moved somewhere else.
    </p>
    <TwFlex Wrap="FlexWrap.Wrap" Justify="JustifyContent.Center" Gap="2" Class="mt-6">
        <TwButton Label="Back to home"
                  Variant="ButtonVariant.Filled"
                  Color="Color.Primary"
                  StartIcon="Icon.House_Door"
                  Href="/" />
        <TwButton Label="Open settings"
                  Variant="ButtonVariant.Outlined"
                  Color="Color.Dark"
                  EndIcon="Icon.Arrow_Right"
                  Href="/settings" />
    </TwFlex>
</TwFlex>
