@page "/not-found"
@layout MainLayout
@inject TwBlazorOptions Options

<PageTitle>Page not found</PageTitle>

<TwFlex Direction="FlexDirection.Col" Align="AlignItems.Center" Justify="JustifyContent.Center" FullHeight Gap="0" Class="min-h-[60vh] px-4 text-center">
    <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-16 rounded-2xl {primaryTile}")">
        <TwIcon Icon="Icon.Compass" Color="Color.Primary" Class="text-3xl" />
    </TwFlex>
    <TwText Element="LayoutElement.P"
            Color="Color.Primary"
            Size="TextSize.Xs"
            Weight="TextWeight.Semibold"
            Class="mt-6 uppercase tracking-widest">404</TwText>
    <TwText Element="LayoutElement.H1" Size="TextSize.Xl3" Weight="TextWeight.Bold" Class="mt-2 tracking-tight sm:text-4xl">This page took a wrong turn.</TwText>
    <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Muted" Class="mt-3 max-w-md leading-6">
        The page you are looking for does not exist, or it may have moved somewhere else.
    </TwText>
    <TwFlex Wrap="FlexWrap.Wrap" Justify="JustifyContent.Center" Gap="2" Class="mt-6">
        <TwButton Label="Back to home"
                  Variant="ButtonVariant.Filled"
                  Color="Color.Primary"
                  StartIcon="Icon.House_Door"
                  Href="/" />
        <TwButton Label="Open settings"
                  Variant="ButtonVariant.Outlined"
                  Color="Color.Dark"
                  EndIcon="Icon.Arrow_Right"
                  Href="/settings" />
    </TwFlex>
</TwFlex>

@code {
    private string primaryTile =>
        $"{Options.Theme.Colors.LightBackground.Lightest.Primary} {Options.Theme.Colors.DarkBackground.Darkest.Primary}";
}
