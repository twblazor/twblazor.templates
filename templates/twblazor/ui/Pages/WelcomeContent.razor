@inject TwBlazorOptions Options

<TwContainer MaxWidth="ContainerSize.Xl6" Gutter="0" Class="space-y-8">
    <TwContainer Element="LayoutElement.Section"
                 MaxWidth="ContainerSize.Full"
                 Gutter="6"
                 PaddingY="8"
                 Class="@($"relative overflow-hidden rounded-3xl border border-gray-200 {primarySubtleSurface} dark:border-white/10 sm:px-10 sm:py-10")">
        <div class="pointer-events-none absolute -end-24 -top-24 size-72 rounded-full bg-white/40 blur-3xl dark:bg-white/5" aria-hidden="true"></div>

        <TwGrid Cols="1" ColsLg="2" Gap="8" Align="AlignItems.Center" Class="relative">
            <div>
                <TwFlex Element="LayoutElement.Span"
                        Inline
                        Align="AlignItems.Center"
                        Gap="1.5"
                        Class="@($"rounded-full border border-gray-200 {primarySubtleSurface} px-3 py-1 dark:border-white/10")">
                    <TwIcon Icon="Icon.Lightning_Charge_Fill" Color="Color.Primary" Class="text-[0.7rem]" />
                    <TwText Color="Color.Primary" Size="TextSize.Xs" Weight="TextWeight.Semibold">twblazor starter</TwText>
                </TwFlex>

                <TwText Element="LayoutElement.H1"
                        Size="TextSize.Xl3"
                        Weight="TextWeight.Bold"
                        Class="mt-4 tracking-tight sm:text-4xl lg:text-5xl">Welcome to twblazor</TwText>
                <TwText Element="LayoutElement.P"
                        Size="TextSize.Sm"
                        Tone="TextTone.Secondary"
                        Class="mt-4 max-w-xl leading-6 sm:text-base">
                    Your twblazor app is ready. Start with the docs, browse the components, or open the source when you want to see how something works.
                </TwText>

                <TwFlex Wrap="FlexWrap.Wrap" Gap="2" Class="mt-6">
                    <TwButton Label="Read the docs"
                              Variant="ButtonVariant.Filled"
                              Color="Color.Primary"
                              StartIcon="Icon.Book"
                              Href="https://twblazor.com"
                              Target="_blank" />
                    <TwButton Label="GitHub"
                              Variant="ButtonVariant.Outlined"
                              Color="Color.Dark"
                              StartIcon="Icon.Github"
                              Href="https://github.com/twblazor/twblazor"
                              Target="_blank" />
                    <TwButton Label="API reference"
                              Variant="ButtonVariant.Text"
                              Color="Color.Dark"
                              EndIcon="Icon.Arrow_Up_Right"
                              Href="https://twblazor.github.io/twblazor/"
                              Target="_blank" />
                </TwFlex>
            </div>

            <TwCard Title="Start here" TitleLevel="2" Bordered="false" Class="h-full bg-white/80 backdrop-blur dark:bg-white/5">
                <TwFlex Direction="FlexDirection.Col" Gap="1">
                    <TwLink Href="https://twblazor.com" Target="_blank" Class="rounded-lg">
                        <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Between" Gap="3" Class="px-2 py-2 hover:bg-gray-100 dark:hover:bg-white/5">
                            <TwFlex Align="AlignItems.Center" Gap="2.5">
                                <TwIcon Icon="Icon.Book" Color="Color.Primary" />
                                <TwText Size="TextSize.Sm" Tone="TextTone.Secondary">Documentation</TwText>
                            </TwFlex>
                            <TwIcon Icon="Icon.Arrow_Up_Right" Class="@($"text-xs {subtleText}")" />
                        </TwFlex>
                    </TwLink>
                    <TwLink Href="https://github.com/twblazor/twblazor" Target="_blank" Class="rounded-lg">
                        <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Between" Gap="3" Class="px-2 py-2 hover:bg-gray-100 dark:hover:bg-white/5">
                            <TwFlex Align="AlignItems.Center" Gap="2.5">
                                <TwIcon Icon="Icon.Github" Color="Color.Primary" />
                                <TwText Size="TextSize.Sm" Tone="TextTone.Secondary">GitHub repository</TwText>
                            </TwFlex>
                            <TwIcon Icon="Icon.Arrow_Up_Right" Class="@($"text-xs {subtleText}")" />
                        </TwFlex>
                    </TwLink>
                    <TwLink Href="https://twblazor.github.io/twblazor/" Target="_blank" Class="rounded-lg">
                        <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Between" Gap="3" Class="px-2 py-2 hover:bg-gray-100 dark:hover:bg-white/5">
                            <TwFlex Align="AlignItems.Center" Gap="2.5">
                                <TwIcon Icon="Icon.Journal_Code" Color="Color.Primary" />
                                <TwText Size="TextSize.Sm" Tone="TextTone.Secondary">API reference</TwText>
                            </TwFlex>
                            <TwIcon Icon="Icon.Arrow_Up_Right" Class="@($"text-xs {subtleText}")" />
                        </TwFlex>
                    </TwLink>
                    <TwLink Href="https://twblazor.com/theme" Target="_blank" Class="rounded-lg">
                        <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Between" Gap="3" Class="px-2 py-2 hover:bg-gray-100 dark:hover:bg-white/5">
                            <TwFlex Align="AlignItems.Center" Gap="2.5">
                                <TwIcon Icon="Icon.Brush" Color="Color.Primary" />
                                <TwText Size="TextSize.Sm" Tone="TextTone.Secondary">Theme builder</TwText>
                            </TwFlex>
                            <TwIcon Icon="Icon.Arrow_Up_Right" Class="@($"text-xs {subtleText}")" />
                        </TwFlex>
                    </TwLink>
                </TwFlex>
            </TwCard>
        </TwGrid>
    </TwContainer>

    <TwGrid Cols="1" ColsSm="2" ColsLg="4" Gap="4">
        <TwCard Title="Documentation" TitleLevel="2" Class="h-full">
            <TwFlex Direction="FlexDirection.Col" FullHeight Gap="3">
                <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-10 rounded-xl {primaryTile}")">
                    <TwIcon Icon="Icon.Book" Color="Color.Primary" Class="text-lg" />
                </TwFlex>
                <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Secondary" Class="leading-6">Guides, live examples and every component parameter.</TwText>
                <TwFlexItem PushEnd>
                    <TwLink Href="https://twblazor.com" Target="_blank" Color="Color.Primary" Size="TextSize.Sm" Weight="TextWeight.Semibold" Class="underline-offset-4 hover:underline">Read the docs</TwLink>
                </TwFlexItem>
            </TwFlex>
        </TwCard>

        <TwCard Title="Source code" TitleLevel="2" Class="h-full">
            <TwFlex Direction="FlexDirection.Col" FullHeight Gap="3">
                <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-10 rounded-xl {primaryTile}")">
                    <TwIcon Icon="Icon.Github" Color="Color.Primary" Class="text-lg" />
                </TwFlex>
                <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Secondary" Class="leading-6">The library, docs and templates are open source on GitHub.</TwText>
                <TwFlexItem PushEnd>
                    <TwLink Href="https://github.com/twblazor/twblazor" Target="_blank" Color="Color.Primary" Size="TextSize.Sm" Weight="TextWeight.Semibold" Class="underline-offset-4 hover:underline">Open GitHub</TwLink>
                </TwFlexItem>
            </TwFlex>
        </TwCard>

        <TwCard Title="API reference" TitleLevel="2" Class="h-full">
            <TwFlex Direction="FlexDirection.Col" FullHeight Gap="3">
                <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-10 rounded-xl {primaryTile}")">
                    <TwIcon Icon="Icon.Journal_Code" Color="Color.Primary" Class="text-lg" />
                </TwFlex>
                <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Secondary" Class="leading-6">Generated reference documentation for every public type.</TwText>
                <TwFlexItem PushEnd>
                    <TwLink Href="https://twblazor.github.io/twblazor/" Target="_blank" Color="Color.Primary" Size="TextSize.Sm" Weight="TextWeight.Semibold" Class="underline-offset-4 hover:underline">Open DocFX</TwLink>
                </TwFlexItem>
            </TwFlex>
        </TwCard>

        <TwCard Title="Theme builder" TitleLevel="2" Class="h-full">
            <TwFlex Direction="FlexDirection.Col" FullHeight Gap="3">
                <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-10 rounded-xl {primaryTile}")">
                    <TwIcon Icon="Icon.Brush" Color="Color.Primary" Class="text-lg" />
                </TwFlex>
                <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Secondary" Class="leading-6">Generate a Theme.cs with your brand colours and the components you use.</TwText>
                <TwFlexItem PushEnd>
                    <TwLink Href="https://twblazor.com/theme" Target="_blank" Color="Color.Primary" Size="TextSize.Sm" Weight="TextWeight.Semibold" Class="underline-offset-4 hover:underline">Open the builder</TwLink>
                </TwFlexItem>
            </TwFlex>
        </TwCard>
    </TwGrid>

    <TwCard Title="Make it yours" TitleLevel="2">
        <TwGrid Cols="1" ColsMd="2" Gap="4">
            <TwFlex Align="AlignItems.Start" Gap="3">
                <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-9 shrink-0 rounded-xl {primaryTile}")">
                    <TwIcon Icon="Icon.Brush" Color="Color.Primary" />
                </TwFlex>
                <div>
                    <TwText Element="LayoutElement.P" Size="TextSize.Sm" Weight="TextWeight.Semibold">Change the theme</TwText>
                    <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Secondary" Class="mt-1 leading-6">
                        Edit <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">Theme.cs</code> or generate a new one at
                        <TwLink Href="https://twblazor.com/theme" Target="_blank" Color="Color.Primary" Weight="TextWeight.Semibold" Class="underline underline-offset-4">twblazor.com/theme</TwLink>.
                    </TwText>
                </div>
            </TwFlex>
            <TwFlex Align="AlignItems.Start" Gap="3">
                <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="@($"size-9 shrink-0 rounded-xl {primaryTile}")">
                    <TwIcon Icon="Icon.File_Text" Color="Color.Primary" />
                </TwFlex>
                <div>
                    <TwText Element="LayoutElement.P" Size="TextSize.Sm" Weight="TextWeight.Semibold">Add a page</TwText>
                    <TwText Element="LayoutElement.P" Size="TextSize.Sm" Tone="TextTone.Secondary" Class="mt-1 leading-6">
                        Create a <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">.razor</code> file in <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">Pages</code> and add its route to <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.8em] dark:bg-white/10">AppNavigation.cs</code>.
                    </TwText>
                </div>
            </TwFlex>
        </TwGrid>
    </TwCard>
</TwContainer>

@code {
    private string subtleText => Options.Theme.Colors.NeutralText.Subtle;

    private string primarySubtleSurface =>
        $"{Options.Theme.Colors.LightBackground.Lightest.Primary} {Options.Theme.Colors.DarkBackground.Darkest.Primary}";

    private string primaryTile =>
        $"{Options.Theme.Colors.LightBackground.Lightest.Primary} {Options.Theme.Colors.DarkBackground.Darkest.Primary}";
}
