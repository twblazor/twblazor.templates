@inherits LayoutComponentBase
@inject ITwToastService ToastService

<TwToastProvider />
<TwDialogProvider />

<TwFlex Direction="FlexDirection.Col" FullHeight Class="min-h-dvh">
    <TwNavbar NavigationItems="@AppNavigation.Top">
        <BrandContent>
            <a href="/" class="rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600">
                <TwFlex Inline Align="AlignItems.Center" Gap="2.5">
                    <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="size-9 shrink-0 rounded-xl bg-linear-to-br from-purple-600 to-fuchsia-500 text-white shadow-sm">
                        <TwIcon Icon="Icon.Lightning_Charge_Fill" Class="text-lg" />
                    </TwFlex>
                    <span class="text-base font-semibold tracking-tight">TwBlazorApp</span>
                </TwFlex>
            </a>
        </BrandContent>
        <ActionsContent>
            <TwButton Label="Sign in"
                      Variant="ButtonVariant.Text"
                      Color="Color.Dark"
                      Dense
                      OnClick="ShowSignInToast" />
            <TwButton Label="Get started"
                      Variant="ButtonVariant.Filled"
                      Color="Color.Primary"
                      Dense
                      Href="/settings" />
        </ActionsContent>
    </TwNavbar>

    <TwContainer Element="LayoutElement.Main" MaxWidth="ContainerSize.Xl6" PaddingY="8" Class="flex-1">
        @Body
    </TwContainer>

    <TwContainer Element="LayoutElement.Footer" MaxWidth="ContainerSize.Xl6" PaddingY="6" Class="border-t border-gray-200 dark:border-white/10">
        <TwFlex Direction="FlexDirection.Col" DirectionSm="FlexDirection.Row" Justify="JustifyContent.Between" Align="AlignItems.Center" Gap="3" Class="text-xs text-gray-500 dark:text-gray-400">
            <p>&copy; @DateTime.Now.Year TwBlazorApp. Built with twblazor.</p>
            <TwFlex Element="LayoutElement.Nav" Gap="5" AriaLabel="Footer">
                <a href="https://twblazor.com" target="_blank" rel="noreferrer" class="font-medium hover:text-gray-900 dark:hover:text-white">Documentation</a>
                <a href="/settings" class="font-medium hover:text-gray-900 dark:hover:text-white">Settings</a>
            </TwFlex>
        </TwFlex>
    </TwContainer>
</TwFlex>

@code {
    private void ShowSignInToast() =>
        ToastService.ShowInfo("Sign in", "Connect this button to your own authentication flow.");
}
