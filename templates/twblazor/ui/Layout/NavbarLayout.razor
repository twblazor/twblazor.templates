@inherits LayoutComponentBase
@inject ITwToastService ToastService
@inject TwBlazorOptions Options

<TwToastProvider />
<TwDialogProvider />

<TwFlex Direction="FlexDirection.Col" FullHeight Class="min-h-dvh">
    <TwNavbar NavigationItems="@AppNavigation.Top">
        <BrandContent>
            <a href="/" class="rounded-lg @Options.Theme.Tokens.FocusRing">
                <TwFlex Inline Align="AlignItems.Center" Gap="2.5">
                    <TwAvatar Icon="Icon.Lightning_Charge_Fill"
                              Color="Color.Primary"
                              Class="size-9 rounded-xl text-base" />
                    <span class="text-base font-semibold tracking-tight">TwBlazorApp</span>
                </TwFlex>
            </a>
        </BrandContent>
        <ActionsContent>
            <TwButton Label="Sign in"
                      Variant="ButtonVariant.Text"
                      Color="Color.Dark"
                      Dense
                      OnClick="ShowSignInToast" />
            <TwButton Label="Get started"
                      Variant="ButtonVariant.Filled"
                      Color="Color.Primary"
                      Dense
                      Href="/settings" />
        </ActionsContent>
    </TwNavbar>

    <TwContainer Element="LayoutElement.Main" MaxWidth="ContainerSize.Xl6" PaddingY="8" Class="flex-1">
        @Body
    </TwContainer>

    <TwContainer Element="LayoutElement.Footer" MaxWidth="ContainerSize.Xl6" PaddingY="6" Class="border-t border-gray-200 dark:border-white/10">
        <TwFlex Direction="FlexDirection.Col" DirectionSm="FlexDirection.Row" Justify="JustifyContent.Between" Align="AlignItems.Center" Gap="3" Class="@($"text-xs {Options.Theme.Colors.NeutralText.Muted}")">
            <p>&copy; @DateTime.Now.Year TwBlazorApp. Built with twblazor.</p>
            <TwFlex Element="LayoutElement.Nav" Gap="5" AriaLabel="Footer">
                <TwLink Href="https://twblazor.com" Target="_blank" Tone="TextTone.Muted" Weight="TextWeight.Medium" Class="hover:text-gray-900 dark:hover:text-white">Documentation</TwLink>
                <TwLink Href="/settings" Tone="TextTone.Muted" Weight="TextWeight.Medium" Class="hover:text-gray-900 dark:hover:text-white">Settings</TwLink>
            </TwFlex>
        </TwFlex>
    </TwContainer>
</TwFlex>

@code {
    private void ShowSignInToast() =>
        ToastService.ShowInfo("Sign in", "Connect this button to your own authentication flow.");
}
