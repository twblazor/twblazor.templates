@inherits LayoutComponentBase
@inject ITwToastService ToastService
@inject TwBlazorOptions Options

<TwToastProvider />
<TwDialogProvider />

<TwSidebar @bind-IsSidebarOpen="sidebarOpen"
           NavigationItems="@AppNavigation.Sidebar"
           MainContentClass="p-4 sm:p-6 lg:p-10">
    <HeaderContent>
        <a href="/" class="rounded-lg @Options.Theme.Tokens.FocusRing">
            <TwFlex Inline Align="AlignItems.Center" Gap="2.5">
                <TwAvatar Icon="Icon.Lightning_Charge_Fill"
                          Color="Color.Primary"
                          Class="size-9 rounded-xl text-base" />
                <span class="text-base font-semibold tracking-tight">TwBlazorApp</span>
            </TwFlex>
        </a>
    </HeaderContent>

    <NavbarActionsContent>
        <TwAvatar AriaLabel="Account" Color="Color.Accent" Size="AvatarSize.Small" />
    </NavbarActionsContent>

    <SidebarContent>
        <TwCard Class="mt-6">
            <TwFlex Align="AlignItems.Center" Gap="2.5">
                <TwAvatar Color="Color.Primary" Size="AvatarSize.Small" />
                <TwFlexItem MinWidthZero>
                    <TwText Element="LayoutElement.P" Size="TextSize.Xs" Weight="TextWeight.Semibold" Truncate>Your account</TwText>
                    <TwText Element="LayoutElement.P" Size="TextSize.Xs" Tone="TextTone.Muted" Truncate>Free plan</TwText>
                </TwFlexItem>
            </TwFlex>
            <TwButton Label="Upgrade plan"
                      Variant="ButtonVariant.Outlined"
                      Color="Color.Primary"
                      Dense
                      Class="mt-3 w-full"
                      OnClick="ShowUpgradeToast" />
        </TwCard>
    </SidebarContent>

    <ChildContent>
        @Body
    </ChildContent>
</TwSidebar>

@code {
    private bool sidebarOpen = true;

    private void ShowUpgradeToast() =>
        ToastService.ShowInfo("Upgrade plan", "Billing is not connected in this starter.");
}
