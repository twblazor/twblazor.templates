@inherits LayoutComponentBase
@inject ITwToastService ToastService

<TwToastProvider />
<TwDialogProvider />

<TwSidebar @bind-IsSidebarOpen="sidebarOpen"
           NavigationItems="@AppNavigation.Sidebar"
           MainContentClass="p-4 sm:p-6 lg:p-10">
    <HeaderContent>
        <a href="/" class="flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600">
            <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-linear-to-br from-purple-600 to-fuchsia-500 text-white shadow-sm">
                <TwIcon Icon="Icon.Lightning_Charge_Fill" Class="text-lg" />
            </span>
            <span class="text-base font-semibold tracking-tight">TwBlazorApp</span>
        </a>
    </HeaderContent>

    <NavbarBrandContent>
        <div class="hidden min-w-0 flex-col sm:flex">
            <span class="truncate text-sm font-semibold leading-5">Your workspace</span>
            <span class="truncate text-xs leading-4 text-gray-500 dark:text-gray-400">A quiet place to get things done.</span>
        </div>
    </NavbarBrandContent>

    <NavbarActionsContent>
        <TwAvatar Name="Jane Doe" Color="Color.Accent" Size="AvatarSize.Small" />
    </NavbarActionsContent>

    <SidebarContent>
        <div class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-3 dark:border-white/10 dark:bg-white/5">
            <div class="flex items-center gap-2.5">
                <TwAvatar Initials="JD" Color="Color.Primary" Size="AvatarSize.Small" />
                <div class="min-w-0">
                    <p class="truncate text-xs font-semibold">Jane Doe</p>
                    <p class="truncate text-xs text-gray-500 dark:text-gray-400">Free plan</p>
                </div>
            </div>
            <TwButton Label="Upgrade plan"
                      Variant="ButtonVariant.Outlined"
                      Color="Color.Primary"
                      Dense
                      Class="mt-3 w-full"
                      OnClick="ShowUpgradeToast" />
        </div>
    </SidebarContent>

    <ChildContent>
        @Body
    </ChildContent>
</TwSidebar>

@code {
    private bool sidebarOpen = true;

    private void ShowUpgradeToast() =>
        ToastService.ShowInfo("Upgrade plan", "Billing is not connected in this starter.");
}
