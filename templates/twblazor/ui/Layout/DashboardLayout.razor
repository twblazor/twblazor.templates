@inherits LayoutComponentBase
@inject ITwToastService ToastService

<TwToastProvider />
<TwDialogProvider />

<TwSidebar @bind-IsSidebarOpen="sidebarOpen"
           NavigationItems="@AppNavigation.Sidebar"
           MainContentClass="p-4 sm:p-6 lg:p-8">
    <HeaderContent>
        <a href="/" class="rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600">
            <TwFlex Inline Align="AlignItems.Center" Gap="2.5">
                <TwFlex Align="AlignItems.Center" Justify="JustifyContent.Center" Class="size-9 shrink-0 rounded-xl bg-linear-to-br from-purple-600 to-fuchsia-500 text-white shadow-sm">
                    <TwIcon Icon="Icon.Lightning_Charge_Fill" Class="text-lg" />
                </TwFlex>
                <span class="text-base font-semibold tracking-tight">TwBlazorApp</span>
            </TwFlex>
        </a>
    </HeaderContent>

    <NavbarActionsContent>
        <TwIcon Icon="Icon.Search" AriaLabel="Search" OnClick="ShowSearchToast" Class="text-lg p-2" />
        <TwIcon Icon="Icon.Bell" AriaLabel="Notifications" OnClick="ShowNotificationsToast" Class="text-lg p-2" />
        <span class="mx-1 hidden h-6 w-px bg-gray-200 sm:block dark:bg-white/10" aria-hidden="true"></span>
        <TwFlex Align="AlignItems.Center" Gap="2.5">
            <TwAvatar Initials="JD" Color="Color.Primary" Size="AvatarSize.Small" />
            <div class="hidden text-start sm:block">
                <p class="text-sm font-medium leading-5">Jane Doe</p>
                <p class="text-xs leading-4 text-gray-500 dark:text-gray-400">Product lead</p>
            </div>
        </TwFlex>
    </NavbarActionsContent>

    <SidebarContent>
        <TwCard Title="Quick start" TitleLevel="3" Class="mt-6">
            <TwFlex Direction="FlexDirection.Col" Align="AlignItems.Start" Gap="2">
                <p class="text-xs leading-5 text-gray-600 dark:text-gray-300">
                    Add a page to <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.7rem] dark:bg-white/10">Pages</code> and its link to <code class="rounded bg-gray-100 px-1 py-0.5 text-[0.7rem] dark:bg-white/10">AppNavigation.cs</code>.
                </p>
                <TwButton Label="Read the docs"
                          Variant="ButtonVariant.Text"
                          Color="Color.Primary"
                          EndIcon="Icon.Arrow_Up_Right"
                          Href="https://twblazor.com"
                          Target="_blank"
                          Class="whitespace-nowrap" />
            </TwFlex>
        </TwCard>
    </SidebarContent>

    <ChildContent>
        @Body
    </ChildContent>
</TwSidebar>

@code {
    private bool sidebarOpen = true;

    private void ShowSearchToast() =>
        ToastService.ShowInfo("Search", "Connect this button to your own search experience.");

    private void ShowNotificationsToast() =>
        ToastService.ShowSuccess("You're all caught up", "There are no new notifications right now.");
}
