@inherits LayoutComponentBase
@inject ITwToastService ToastService

<TwToastProvider />
<TwDialogProvider />

<TwSidebar @bind-IsSidebarOpen="sidebarOpen"
           NavigationItems="@AppNavigation.Sidebar"
           MainContentClass="p-4 sm:p-6 lg:p-8">
    <HeaderContent>
        <a href="/" class="flex items-center gap-2.5 rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-purple-600">
            <span class="grid size-9 shrink-0 place-items-center rounded-xl bg-linear-to-br from-purple-600 to-fuchsia-500 text-white shadow-sm">
                <TwIcon Icon="Icon.Lightning_Charge_Fill" Class="text-lg" />
            </span>
            <span class="text-base font-semibold tracking-tight">TwBlazorApp</span>
        </a>
    </HeaderContent>

    <NavbarBrandContent>
        <div class="hidden min-w-0 flex-col sm:flex">
            <span class="truncate text-sm font-semibold leading-5">Workspace overview</span>
            <span class="truncate text-xs leading-4 text-gray-500 dark:text-gray-400">Here is what is happening today.</span>
        </div>
    </NavbarBrandContent>

    <NavbarActionsContent>
        <TwIcon Icon="Icon.Search" AriaLabel="Search" OnClick="ShowSearchToast" Class="text-lg p-2" />
        <TwIcon Icon="Icon.Bell" AriaLabel="Notifications" OnClick="ShowNotificationsToast" Class="text-lg p-2" />
        <span class="mx-1 hidden h-6 w-px bg-gray-200 sm:block dark:bg-white/10" aria-hidden="true"></span>
        <div class="flex items-center gap-2.5">
            <TwAvatar Initials="JD" Color="Color.Primary" Size="AvatarSize.Small" />
            <div class="hidden text-start sm:block">
                <p class="text-sm font-medium leading-5">Jane Doe</p>
                <p class="text-xs leading-4 text-gray-500 dark:text-gray-400">Product lead</p>
            </div>
        </div>
    </NavbarActionsContent>

    <SidebarContent>
        <div class="mt-6 rounded-xl border border-gray-200 bg-gray-50 p-3 dark:border-white/10 dark:bg-white/5">
            <p class="text-xs font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400">Quick start</p>
            <p class="mt-1.5 text-xs leading-5 text-gray-600 dark:text-gray-300">
                Add a page to <code class="rounded bg-white px-1 py-0.5 text-[0.7rem] dark:bg-white/10">Pages</code> and its link to <code class="rounded bg-white px-1 py-0.5 text-[0.7rem] dark:bg-white/10">AppNavigation.cs</code>.
            </p>
            <a href="https://twblazor.com" target="_blank" rel="noreferrer" class="mt-3 inline-flex items-center gap-1 text-xs font-semibold text-purple-700 hover:text-purple-900 dark:text-purple-300 dark:hover:text-purple-200">
                Read the docs
                <TwIcon Icon="Icon.Arrow_Up_Right" Class="text-[0.7rem]" />
            </a>
        </div>
    </SidebarContent>

    <ChildContent>
        @Body
    </ChildContent>
</TwSidebar>

@code {
    private bool sidebarOpen = true;

    private void ShowSearchToast() =>
        ToastService.ShowInfo("Search", "Connect this button to your own search experience.");

    private void ShowNotificationsToast() =>
        ToastService.ShowSuccess("You're all caught up", "There are no new notifications right now.");
}
